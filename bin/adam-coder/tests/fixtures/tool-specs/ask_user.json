{
  "name": "ask_user",
  "description": "Ask the person who gave you the task a question and wait for the answer. Use it only when you cannot proceed without it, or to get explicit consent (for example to open a pull request with failing checks). Be specific. `question` is always required: it is the sentence the person reads first. When the answer is one of a few options, pass `choices` instead of listing the options in your text: the person gets one form and answers every question together. Give the form a short `title` and a `description` of why you ask; give each option a short `label`, a `description` of what it means or costs, and `recommended: true` on the one you advise. A question's `type`: `single` (the default), `multiple`, `select`, `images` (each option has an `image` of a file you shared), `text`, `longText`, `confirm` (yes or no: use it for consent before something that cannot be undone), `number`, `scale`, `date` or `rank`; the fields marked with a type belong to it. A screen that lacks a type gets the nearest form. An answer that breaks a rule of the form goes back to the person, at most 5 times; words the person typed instead reach you unchecked. `show` draws what a question is about (above all before consent). With a single possible answer, or none you know, ask a plain question without `choices`.",
  "parameters": {
    "type": "object",
    "properties": {
      "question": {
        "type": "string",
        "minLength": 1,
        "description": "What you need to know, or the sentence that opens the form"
      },
      "title": {
        "type": "string",
        "description": "The form's heading (with `choices`)"
      },
      "description": {
        "type": "string",
        "description": "Why you ask, in plain text (with `choices`)"
      },
      "choices": {
        "type": "array",
        "maxItems": 8,
        "description": "Questions with fixed answers, as one form. Each needs `question`, and `options` unless it is typed.",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
              "description": "Its id in the answer; q1, q2, ... when omitted"
            },
            "question": {
              "type": "string",
              "minLength": 1
            },
            "help": {
              "type": "string",
              "description": "A line under the question"
            },
            "show": {
              "description": "Blocks drawn with the question (8 in all the form), each {component, ...}: Code for a diff, a command or a file; Text, Image (artifact: sha256, alt), Mermaid, Cards, Callout, Chart",
              "items": {
                "additionalProperties": true,
                "properties": {
                  "component": {
                    "enum": [
                      "Text",
                      "Image",
                      "Mermaid",
                      "Code",
                      "Cards",
                      "Callout",
                      "Chart"
                    ]
                  }
                },
                "required": [
                  "component"
                ],
                "type": "object"
              },
              "maxItems": 4,
              "minItems": 1,
              "type": "array"
            },
            "type": {
              "enum": [
                "single",
                "multiple",
                "select",
                "images",
                "text",
                "longText",
                "confirm",
                "number",
                "scale",
                "date",
                "rank"
              ],
              "description": "single (radio buttons, the default), multiple (checkboxes), select (searchable list), images, text, longText, confirm, number, scale (a rating), date, rank (put the options in order)"
            },
            "options": {
              "type": "array",
              "maxItems": 50,
              "description": "Each a label or an object: 2 to 12 for single, multiple and rank, 2 to 50 for select, 2 to 16 for images; none for the others",
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "properties": {
                      "description": {
                        "description": "What it means or costs, in a short sentence",
                        "type": "string"
                      },
                      "icon": {
                        "enum": [
                          "agent",
                          "read",
                          "edit",
                          "delete",
                          "move",
                          "search",
                          "execute",
                          "think",
                          "fetch",
                          "web",
                          "git",
                          "test",
                          "file",
                          "tool",
                          "opencode"
                        ]
                      },
                      "image": {
                        "description": "images only: the sha256 of an image file you shared, never a URL",
                        "properties": {
                          "alt": {
                            "minLength": 1,
                            "type": "string"
                          },
                          "sha256": {
                            "pattern": "^[0-9a-f]{64}$",
                            "type": "string"
                          }
                        },
                        "required": [
                          "sha256",
                          "alt"
                        ],
                        "type": "object"
                      },
                      "label": {
                        "description": "A few words",
                        "minLength": 1,
                        "type": "string"
                      },
                      "recommended": {
                        "type": "boolean"
                      },
                      "value": {
                        "description": "Its id in the answer; made from the label when omitted",
                        "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
                        "type": "string"
                      }
                    },
                    "required": [
                      "label"
                    ],
                    "type": "object"
                  }
                ]
              }
            },
            "multiple": {
              "type": "boolean",
              "description": "Several may be picked (also with select and images)"
            },
            "allowOther": {
              "type": "boolean",
              "description": "Offer an \"Other\" to write in"
            },
            "required": {
              "type": "boolean",
              "description": "Must be answered (the default)"
            },
            "default": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              ],
              "description": "The first answer shown: option value(s) or label(s), starting words, \"yes\"/\"no\" (the safe one), a decimal, a point, a day, or every option once for rank"
            },
            "min": {
              "type": "integer",
              "minimum": 0,
              "description": "Fewest to pick"
            },
            "max": {
              "type": "integer",
              "minimum": 1,
              "description": "Most to pick"
            },
            "from": {
              "description": "scale: the first point (1 when absent)",
              "maximum": 1,
              "minimum": 0,
              "type": "integer"
            },
            "fromLabel": {
              "description": "scale: words at the first point",
              "maxLength": 60,
              "minLength": 1,
              "type": "string"
            },
            "maxDate": {
              "description": "date: the last day allowed",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "type": "string"
            },
            "maxValue": {
              "description": "number: the most",
              "type": [
                "string",
                "number"
              ]
            },
            "minDate": {
              "description": "date: the first day allowed",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "type": "string"
            },
            "minValue": {
              "description": "number: the least",
              "type": [
                "string",
                "number"
              ]
            },
            "noLabel": {
              "description": "confirm: the no button",
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            },
            "step": {
              "description": "number: the step from the least (or 0)",
              "type": [
                "string",
                "number"
              ]
            },
            "to": {
              "description": "scale, required: the last point",
              "maximum": 10,
              "minimum": 2,
              "type": "integer"
            },
            "toLabel": {
              "description": "scale: words at the last point",
              "maxLength": 60,
              "minLength": 1,
              "type": "string"
            },
            "unit": {
              "description": "number: the unit (EUR, kg)",
              "maxLength": 20,
              "minLength": 1,
              "type": "string"
            },
            "yesLabel": {
              "description": "confirm: the yes button",
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "question"
          ]
        }
      },
      "freeInput": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "properties": {
              "label": {
                "type": "string"
              },
              "placeholder": {
                "type": "string"
              }
            },
            "type": "object"
          }
        ],
        "description": "An \"anything else\" box; its words come back as the answer's note"
      },
      "submitLabel": {
        "type": "string",
        "description": "The button's words"
      }
    },
    "required": [
      "question"
    ]
  }
}
