{
  "mappings": [
    {
      "name": "final answer after a tool result (stream)",
      "priority": 2,
      "request": {
        "method": "POST",
        "urlPathPattern": "(/v1)?/chat/completions",
        "bodyPatterns": [
          {
            "matchesJsonPath": {
              "expression": "$.stream",
              "equalTo": "true"
            }
          },
          {
            "matchesJsonPath": "$.messages[?(@.role == 'tool')]"
          }
        ]
      },
      "response": {
        "status": 200,
        "bodyFileName": "chat-final.sse",
        "transformers": [
          "response-template"
        ],
        "headers": {
          "Content-Type": "text/event-stream; charset=utf-8",
          "Cache-Control": "no-cache"
        },
        "chunkedDribbleDelay": {
          "numberOfChunks": 5,
          "totalDuration": 250
        }
      }
    },
    {
      "name": "final answer after a tool result",
