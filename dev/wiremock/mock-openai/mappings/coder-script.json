  "mappings": [
    {
      "name": "coder script: greeting",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPathPattern": "(/v1)?/chat/completions",
        "bodyPatterns": [
          {
            "matchesJsonPath": {
              "expression": "$.model",
              "equalTo": "mock-coder"
            }
          },
          {
            "doesNotContain": "[mock:no-opencode]"
          },
          {
            "doesNotContain": "tool_call_id"
          },
          {
            "matchesJsonPath": {
              "expression": "$.messages[1].content",
              "matches": "(?is)^\\s*(hi|hello|hey)\\b.*"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "id": "chatcmpl-coder-script-greeting",
          "object": "chat.completion",
          "created": 1700000000,
          "model": "mock-coder",
          "system_fingerprint": "fp_mock",
          "choices": [
            {
              "index": 0,
              "message": {
                "role": "assistant",
                "content": "Hi! I'm {{regexExtract (jsonPath request.body '$.messages[0].content') 'Your name is ([A-Za-z0-9 _-]+)' 'name'}}{{name.0}}. {{regexExtract (jsonPath request.body '$.messages[0].content') 'In one sentence: ([^.]+)' 'summary'}}{{summary.0}}. Which repository should I work on, and what should I change?"
              },
              "logprobs": null,
              "finish_reason": "stop"
            }
          ],
          "usage": {
            "prompt_tokens": 100,
            "completion_tokens": 20,
            "total_tokens": 120
          }
        }
      }
    },
