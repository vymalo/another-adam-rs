{{#assign 'cid'~}}chatcmpl-mock{{randomValue length=12 type='ALPHANUMERIC'}}{{~/assign}}
{{~#assign 'model'~}}{{{toJson (jsonPath request.body '$.model' default='mock-model')}}}{{~/assign}}
{{~#assign 'ts'~}}{{now format='unix'}}{{~/assign~}}
data: {"id":"{{cid}}","object":"chat.completion.chunk","created":{{ts}},"model":{{{model}}},"choices":[{"index":0,"delta":{"role":"assistant","content":""},"finish_reason":null}]}

data: {"id":"{{cid}}","object":"chat.completion.chunk","created":{{ts}},"model":{{{model}}},"choices":[{"index":0,"delta":{"content":"Hello from the mock model. "},"finish_reason":null}]}

data: {"id":"{{cid}}","object":"chat.completion.chunk","created":{{ts}},"model":{{{model}}},"choices":[{"index":0,"delta":{"content":"This is a canned answer from mock-openai."},"finish_reason":null}]}

data: {"id":"{{cid}}","object":"chat.completion.chunk","created":{{ts}},"model":{{{model}}},"choices":[{"index":0,"delta":{},"finish_reason":"stop"}]}

data: {"id":"{{cid}}","object":"chat.completion.chunk","created":{{ts}},"model":{{{model}}},"choices":[],"usage":{"prompt_tokens":12,"completion_tokens":14,"total_tokens":26}}

data: [DONE]

