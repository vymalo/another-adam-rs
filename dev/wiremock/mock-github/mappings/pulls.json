{
  "mappings": [
    {
      "name": "401 (header)",
      "priority": 1,
      "request": {
        "urlPathPattern": "/repos/[^/]+/[^/]+/pulls",
        "headers": {
          "X-Mock-Scenario": {
            "equalTo": "unauthorized"
          }
        }
      },
      "response": {
        "status": 401,
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "jsonBody": {
          "message": "Bad credentials",
          "documentation_url": "https://docs.github.com/rest/pulls/pulls"
        }
      }
    },
    {
      "name": "401 (bad token)",
      "priority": 1,
      "request": {
        "urlPathPattern": "/repos/[^/]+/[^/]+/pulls",
        "headers": {
          "Authorization": {
            "equalTo": "Bearer bad-token"
          }
        }
      },
      "response": {
        "status": 401,
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "jsonBody": {
          "message": "Bad credentials",
          "documentation_url": "https://docs.github.com/rest/pulls/pulls"
        }
      }
    },
    {
      "name": "401 (keyword)",
      "priority": 1,
      "request": {
        "urlPathPattern": "/repos/[^/]+/[^/]+/pulls",
        "method": "POST",
        "bodyPatterns": [
          {
            "contains": "[mock:unauthorized]"
          }
        ]
      },
      "response": {
        "status": 401,
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "jsonBody": {
          "message": "Bad credentials",
          "documentation_url": "https://docs.github.com/rest/pulls/pulls"
        }
      }
    },
    {
      "name": "rate limit (header)",
      "priority": 2,
      "request": {
        "urlPathPattern": "/repos/[^/]+/[^/]+/pulls",
        "headers": {
          "X-Mock-Scenario": {
            "equalTo": "rate-limit"
          }
        }
      },
      "response": {
        "status": 403,
        "headers": {
          "Content-Type": "application/json; charset=utf-8",
          "x-ratelimit-remaining": "0",
          "x-ratelimit-limit": "5000",
          "x-ratelimit-reset": "1893456000"
        },
        "jsonBody": {
          "message": "API rate limit exceeded for user ID 1.",
          "documentation_url": "https://docs.github.com/rest/pulls/pulls"
        }
      }
    },
    {
      "name": "rate limit (keyword)",
