    {
      "name": "already exists: create (header)",
      "priority": 2,
      "request": {
        "urlPathPattern": "/repos/[^/]+/[^/]+/pulls",
        "method": "POST",
        "headers": {
          "X-Mock-Scenario": {
            "equalTo": "already-exists"
          }
        }
      },
      "response": {
        "status": 422,
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "jsonBody": {
          "message": "Validation Failed",
          "documentation_url": "https://docs.github.com/rest/pulls/pulls",
          "errors": [
            {
              "resource": "PullRequest",
              "code": "custom",
              "message": "A pull request already exists for mock-owner:agent/mock."
            }
          ]
        }
      },
      "scenarioName": "already-exists",
      "requiredScenarioState": "Started",
      "newScenarioState": "PR exists"
    },
    {
      "name": "already exists: create (keyword)",
      "priority": 2,
      "request": {
        "urlPathPattern": "/repos/[^/]+/[^/]+/pulls",
        "method": "POST",
        "bodyPatterns": [
          {
            "contains": "[mock:already-exists]"
          }
        ]
      },
