    {
      "name": "already exists: the next probe finds it",
      "priority": 3,
      "request": {
        "urlPathPattern": "/repos/[^/]+/[^/]+/pulls",
        "method": "GET"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json; charset=utf-8",
          "X-GitHub-Media-Type": "github.v3; format=json",
          "x-ratelimit-limit": "5000",
          "x-ratelimit-remaining": "4999"
        },
        "bodyFileName": "pull-list-existing.json",
        "transformers": [
          "response-template"
        ]
      },
      "scenarioName": "already-exists",
      "requiredScenarioState": "PR exists",
      "newScenarioState": "Started"
    },
    {
      "name": "probe finds an open PR (head contains already-open)",
      "priority": 3,
      "request": {
        "urlPathPattern": "/repos/[^/]+/[^/]+/pulls",
        "method": "GET",
        "queryParameters": {
          "head": {
            "contains": "already-open"
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json; charset=utf-8",
