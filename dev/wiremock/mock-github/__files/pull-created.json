{{#assign 'n'~}}{{randomInt lower=100 upper=9999}}{{~/assign~}}
{{#assign 'o'~}}{{request.path.[1]}}{{~/assign~}}
{{#assign 'r'~}}{{request.path.[2]}}{{~/assign~}}
{{#assign 'branch'~}}{{regexExtract (jsonPath request.body '$.head' default='mock-branch') '[^:]+$'}}{{~/assign~}}
{
  "url": "{{request.baseUrl}}/repos/{{o}}/{{r}}/pulls/{{n}}",
  "id": 100{{n}},
  "node_id": "PR_mock{{n}}",
  "html_url": "{{request.baseUrl}}/{{o}}/{{r}}/pull/{{n}}",
  "number": {{n}},
  "state": "open",
  "locked": false,
  "draft": {{jsonPath request.body '$.draft' default='false'}},
  "title": {{{toJson (jsonPath request.body '$.title' default='')}}},
  "body": {{{toJson (jsonPath request.body '$.body' default='')}}},
  "user": {"login": "mock-user", "type": "User"},
  "head": {"label": "{{o}}:{{branch}}", "ref": {{{toJson branch}}}, "sha": "0000000000000000000000000000000000000001"},
  "base": {"label": "{{o}}:{{jsonPath request.body '$.base' default='main'}}", "ref": {{{toJson (jsonPath request.body '$.base' default='main')}}}, "sha": "0000000000000000000000000000000000000000"},
  "merged": false,
  "mergeable": null,
  "created_at": "{{now format="yyyy-MM-dd'T'HH:mm:ss'Z'"}}",
  "updated_at": "{{now format="yyyy-MM-dd'T'HH:mm:ss'Z'"}}"
}
